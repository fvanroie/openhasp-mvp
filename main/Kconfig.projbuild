menu "openHASP Board Configuration"

config BOARD_LVGL_USE_DSI
    bool "Use DSI LCD support"
    default n
    help
        Enable LVGL support for DSI LCD panels.

config BOARD_LVGL_USE_RGB
    bool "Use RGB LCD support"
    default n
    help
        Enable LVGL support for RGB LCD panels.

config BOARD_LVGL_USE_RGB_3WIRE_SPI
    bool "Use RGB+3-wire SPI LCD support"
    default n
    help
        Enable LVGL support for LCD panels using an RGB pixel bus
        with a 3-wire SPI command/initialization interface.

endmenu